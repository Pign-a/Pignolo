datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  tenantId     Int
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  notes        Note[]
}

model Note {
  id     Int    @id @default(autoincrement())
  body   String
  userId Int
  user   User   @relation(fields: [userId], references: [id])
}
